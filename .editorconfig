root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
indent_style = space
indent_size = 2
trim_trailing_whitespace = true

[*.py]
indent_size = 4

[*.md]
# List continuation indentation depends on the marker width.
indent_size = unset

[*.php]
indent_size = 4

[*.neon]
indent_size = 4
