lib: path:
(import ./runtime-path.nix lib) path
&& !lib.elem path [
  "/"
  "/bin"
  "/sbin"
  "/lib"
  "/lib64"
  "/boot"
  "/dev"
  "/etc"
  "/media"
  "/mnt"
  "/opt"
  "/var/lib/private"
  "/home"
  "/root"
  "/nix"
  "/proc"
  "/run"
  "/srv"
  "/sys"
  "/usr"
  "/var"
  "/var/lib"
  "/var/cache"
  "/var/log"
  "/var/tmp"
  "/tmp"
]
&& !lib.any (tree: lib.hasPrefix "${tree}/" path) [
  "/bin"
  "/sbin"
  "/lib"
  "/lib64"
  "/boot"
  "/dev"
  "/etc"
  "/nix"
  "/proc"
  "/sys"
  "/usr"
  "/var/lib/private"
  "/run/credentials"
  "/run/secrets"
]
